
-- 1. Doctors by hospital
SELECT d.*
FROM doctors d
JOIN hospitals h ON d.hospital_id = h.hospital_id
ORDER BY h.name;

-- 2. Prescriptions for one patient
SELECT pr.*
FROM prescriptions pr
JOIN patients p ON pr.patient_id = p.person_id
WHERE p.person_id = 101
ORDER BY pr.prescription_date DESC;

-- 3. Prescriptions by doctor
SELECT d.name AS doctor_name,
       p.name AS patient_name,
       pr.medication,
       pr.prescription_date
FROM prescriptions pr
JOIN doctors d ON pr.doctor_id = d.person_id
JOIN patients p ON pr.patient_id = p.person_id
ORDER BY d.name, pr.prescription_date DESC;

-- 4. Add a new patient registered with a doctor
INSERT INTO patients (person_id, name, date_of_birth, address, role, doctor_id)
VALUES (301, 'Nirosha Jay', '1995-05-14', '12 High Street, Wolverhampton', 'patient', 3);

-- 5. Doctor with the most prescriptions
SELECT d.person_id, d.name, COUNT(*) AS total_prescriptions
FROM prescriptions pr
JOIN doctors d ON pr.doctor_id = d.person_id
GROUP BY d.person_id, d.name
ORDER BY total_prescriptions DESC
LIMIT 1;

-- 6. Doctors at the hospital with the most beds
SELECT d.*, h.name AS hospital_name
FROM doctors d
JOIN hospitals h ON d.hospital_id = h.hospital_id
WHERE h.size = (SELECT MAX(size) FROM hospitals);
EOF
